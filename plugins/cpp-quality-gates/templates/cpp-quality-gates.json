{
  "crap": {
    "roots": ["src"],
    "max": 8,
    "suffixes": [".cpp", ".cc", ".cxx", ".cppm", ".hpp", ".h"]
  },
  "coverage": {
    "preset": "coverage",
    "build_dir": "build/coverage",
    "gcov": "gcov",
    "filters": ["src/"]
  },
  "mutation": {
    "build": "cmake --build build/mutate",
    "test": "ctest --test-dir build/mutate --output-on-failure",
    "triage": ".claude/mutation_triage.txt",
    "ignore": ".claude/mutation_ignore.txt",
    "sample": 200,
    "seed": 1,
    "compile_time_marker": "static assertion failed"
  }
}
